# Copy this file to `.env` and fill in real values. The Django settings module
# refuses to start if `.env` is missing.

# Random string used for cryptographic signing. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me

# 1 = development (SQLite, debug toolbar, verbose errors).
# 0 = production (PostgreSQL using the keys below).
DJANGO_DEBUG=1

# Postgres connection details. Only consulted when DJANGO_DEBUG=0.
POSTGRES_DB=openmv
POSTGRES_USER=openmv
POSTGRES_PASSWORD=change-me
SQL_HOST=127.0.0.1
SQL_PORT=5432
